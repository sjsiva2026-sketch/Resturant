// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  GUEST
  RECEPTIONIST
  HOUSEKEEPING
  ADMIN
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  DIRTY
  CLEANING
  MAINTENANCE
  OUT_OF_SERVICE
}

enum ReservationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  PAYMENT_FAILED
}

enum BookingSource {
  WEBSITE
  WALK_IN
  PHONE
  WHATSAPP
  EMAIL
  ADMIN
  CORPORATE
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  STRIPE
  UPI
  CARD
  NET_BANKING
  CASH
  BANK_TRANSFER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum AddonPricing {
  PER_BOOKING
  PER_ROOM
  PER_PERSON
  PER_NIGHT
  PER_PERSON_PER_NIGHT
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum HousekeepingStatus {
  DIRTY
  CLEANING
  CLEAN
  INSPECTED
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?
  passwordHash  String    @map("password_hash")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  role          UserRole  @default(GUEST)
  isActive      Boolean   @default(true) @map("is_active")
  avatar        String?
  company       String?
  gstNumber     String?   @map("gst_number")
  address       String?
  city          String?
  state         String?
  country       String?   @default("India")
  postalCode    String?   @map("postal_code")
  
  // Guest-specific
  totalStays    Int       @default(0) @map("total_stays")
  totalNights   Int       @default(0) @map("total_nights")
  totalSpending Decimal   @default(0) @map("total_spending") @db.Decimal(12, 2)
  firstStay     DateTime? @map("first_stay")
  lastStay      DateTime? @map("last_stay")
  internalNotes String?   @map("internal_notes")
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  reservations      Reservation[]
  auditLogs         AuditLog[]
  staffAssignments  HousekeepingTask[] @relation("AssignedTo")
  maintenanceReported MaintenanceTicket[] @relation("ReportedBy")
  maintenanceAssigned MaintenanceTicket[] @relation("AssignedToMaintenance")
  notifications     Notification[]
  sessions          Session[]
  passwordResets    PasswordReset[]
  
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  token        String   @unique
  refreshToken String   @unique @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sessions")
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("password_resets")
}

// ============================================
// ROOM TYPES & ROOMS
// ============================================

model RoomType {
  id            String  @id @default(cuid())
  name          String
  slug          String  @unique
  description   String? @db.Text
  shortDescription String? @map("short_description")
  maxAdults     Int     @default(2) @map("max_adults")
  maxChildren   Int     @default(1) @map("max_children")
  maxOccupancy  Int     @default(3) @map("max_occupancy")
  bedType       String  @default("King") @map("bed_type")
  sizeSqft      Int?    @map("size_sqft")
  viewType      String? @map("view_type")
  isSmoking     Boolean @default(false) @map("is_smoking")
  floor         String? 
  basePrice     Decimal @default(0) @map("base_price") @db.Decimal(10, 2)
  isActive      Boolean @default(true) @map("is_active")
  sortOrder     Int     @default(0) @map("sort_order")
  metaTitle     String? @map("meta_title")
  metaDescription String? @map("meta_description")
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  rooms           Room[]
  images          RoomImage[]
  amenities       RoomTypeAmenity[]
  ratePlans       RatePlan[]
  reservationRooms ReservationRoom[]
  bookingHolds    BookingHold[]
  offerRoomTypes  OfferRoomType[]
  couponRoomTypes CouponRoomType[]
  
  @@map("room_types")
}

model Room {
  id         String     @id @default(cuid())
  roomTypeId String     @map("room_type_id")
  roomNumber String     @unique @map("room_number")
  floor      Int        @default(1)
  status     RoomStatus @default(AVAILABLE)
  isActive   Boolean    @default(true) @map("is_active")
  notes      String?
  
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  
  roomType          RoomType           @relation(fields: [roomTypeId], references: [id])
  reservationRooms  ReservationRoom[]
  housekeepingTasks HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
  availabilityBlocks AvailabilityBlock[]
  
  @@map("rooms")
}

model RoomImage {
  id         String  @id @default(cuid())
  roomTypeId String  @map("room_type_id")
  url        String
  alt        String?
  sortOrder  Int     @default(0) @map("sort_order")
  isFeatured Boolean @default(false) @map("is_featured")
  
  createdAt  DateTime @default(now()) @map("created_at")
  
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  
  @@map("room_images")
}

// ============================================
// AMENITIES
// ============================================

model Amenity {
  id       String  @id @default(cuid())
  name     String  @unique
  icon     String?
  category String? 
  isActive Boolean @default(true) @map("is_active")
  
  roomTypes RoomTypeAmenity[]
  
  @@map("amenities")
}

model RoomTypeAmenity {
  id         String @id @default(cuid())
  roomTypeId String @map("room_type_id")
  amenityId  String @map("amenity_id")
  
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  
  @@unique([roomTypeId, amenityId])
  @@map("room_type_amenities")
}

// ============================================
// RATE PLANS & PRICING
// ============================================

model RatePlan {
  id                 String  @id @default(cuid())
  roomTypeId         String  @map("room_type_id")
  name               String
  description        String? @db.Text
  baseRate           Decimal @map("base_rate") @db.Decimal(10, 2)
  includedServices   String? @map("included_services") @db.Text
  cancellationPolicy String? @map("cancellation_policy") @db.Text
  paymentPolicy      String? @map("payment_policy")
  isRefundable       Boolean @default(true) @map("is_refundable")
  minStay            Int     @default(1) @map("min_stay")
  maxStay            Int     @default(30) @map("max_stay")
  isActive           Boolean @default(true) @map("is_active")
  sortOrder          Int     @default(0) @map("sort_order")
  
  // Cancellation config (hours before check-in)
  freeCancellationHours  Int @default(48) @map("free_cancellation_hours")
  lateCancellationCharge Int @default(50) @map("late_cancellation_charge") // percentage
  
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  
  roomType         RoomType          @relation(fields: [roomTypeId], references: [id])
  roomRates        RoomRate[]
  reservationRooms ReservationRoom[]
  
  @@map("rate_plans")
}

model RoomRate {
  id         String   @id @default(cuid())
  ratePlanId String   @map("rate_plan_id")
  date       DateTime @db.Date
  rate       Decimal  @db.Decimal(10, 2)
  isClosed   Boolean  @default(false) @map("is_closed")
  minStay    Int?     @map("min_stay")
  
  createdAt  DateTime @default(now()) @map("created_at")
  
  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  
  @@unique([ratePlanId, date])
  @@index([date])
  @@map("room_rates")
}

model AvailabilityBlock {
  id        String   @id @default(cuid())
  roomId    String   @map("room_id")
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  reason    String?
  
  createdAt DateTime @default(now()) @map("created_at")
  
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  @@map("availability_blocks")
}

// ============================================
// RESERVATIONS
// ============================================

model Reservation {
  id              String            @id @default(cuid())
  bookingId       String            @unique @map("booking_id")
  guestId         String            @map("guest_id")
  checkIn         DateTime          @map("check_in") @db.Date
  checkOut        DateTime          @map("check_out") @db.Date
  adults          Int               @default(2)
  children        Int               @default(0)
  numRooms        Int               @default(1) @map("num_rooms")
  status          ReservationStatus @default(PENDING_PAYMENT)
  source          BookingSource     @default(WEBSITE)
  
  // Pricing snapshot
  subtotal        Decimal           @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal           @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount  Decimal           @default(0) @map("discount_amount") @db.Decimal(12, 2)
  addonAmount     Decimal           @default(0) @map("addon_amount") @db.Decimal(12, 2)
  totalAmount     Decimal           @default(0) @map("total_amount") @db.Decimal(12, 2)
  
  // Coupon
  couponId        String?           @map("coupon_id")
  couponCode      String?           @map("coupon_code")
  
  // Guest details (snapshot - so changes to user profile don't affect booking)
  guestFirstName  String            @map("guest_first_name")
  guestLastName   String            @map("guest_last_name")
  guestEmail      String            @map("guest_email")
  guestPhone      String            @map("guest_phone")
  guestCountry    String?           @map("guest_country")
  guestAddress    String?           @map("guest_address")
  guestCity       String?           @map("guest_city")
  guestState      String?           @map("guest_state")
  guestPostalCode String?           @map("guest_postal_code")
  guestCompany    String?           @map("guest_company")
  guestGstNumber  String?           @map("guest_gst_number")
  
  specialRequests String?           @map("special_requests") @db.Text
  arrivalTime     String?           @map("arrival_time")
  
  // Check-in/out timestamps
  checkedInAt     DateTime?         @map("checked_in_at")
  checkedOutAt    DateTime?         @map("checked_out_at")
  checkedInBy     String?           @map("checked_in_by")
  checkedOutBy    String?           @map("checked_out_by")
  
  // Cancellation
  cancelledAt     DateTime?         @map("cancelled_at")
  cancellationReason String?        @map("cancellation_reason")
  cancellationFee Decimal?          @map("cancellation_fee") @db.Decimal(12, 2)
  
  notes           String?           @db.Text
  
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  
  guest            User              @relation(fields: [guestId], references: [id])
  coupon           Coupon?           @relation(fields: [couponId], references: [id])
  reservationRooms ReservationRoom[]
  reservationAddons ReservationAddon[]
  payments         Payment[]
  invoices         Invoice[]
  
  @@index([checkIn, checkOut])
  @@index([status])
  @@index([guestEmail])
  @@index([guestPhone])
  @@index([createdAt])
  @@map("reservations")
}

model ReservationRoom {
  id           String @id @default(cuid())
  reservationId String @map("reservation_id")
  roomId       String? @map("room_id") // null until room is assigned at check-in
  roomTypeId   String @map("room_type_id")
  ratePlanId   String @map("rate_plan_id")
  ratePerNight Decimal @map("rate_per_night") @db.Decimal(10, 2)
  
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room        Room?       @relation(fields: [roomId], references: [id])
  roomType    RoomType    @relation(fields: [roomTypeId], references: [id])
  ratePlan    RatePlan    @relation(fields: [ratePlanId], references: [id])
  
  @@map("reservation_rooms")
}

model BookingHold {
  id         String   @id @default(cuid())
  roomTypeId String   @map("room_type_id")
  checkIn    DateTime @map("check_in") @db.Date
  checkOut   DateTime @map("check_out") @db.Date
  roomsHeld  Int      @default(1) @map("rooms_held")
  sessionId  String   @map("session_id")
  expiresAt  DateTime @map("expires_at")
  isReleased Boolean  @default(false) @map("is_released")
  
  createdAt  DateTime @default(now()) @map("created_at")
  
  roomType RoomType @relation(fields: [roomTypeId], references: [id])
  
  @@index([expiresAt])
  @@index([sessionId])
  @@map("booking_holds")
}

// ============================================
// ADD-ONS
// ============================================

model Addon {
  id           String      @id @default(cuid())
  name         String
  description  String?
  price        Decimal     @db.Decimal(10, 2)
  pricingMethod AddonPricing @default(PER_BOOKING) @map("pricing_method")
  isActive     Boolean     @default(true) @map("is_active")
  sortOrder    Int         @default(0) @map("sort_order")
  icon         String?
  
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  
  reservationAddons ReservationAddon[]
  
  @@map("addons")
}

model ReservationAddon {
  id            String @id @default(cuid())
  reservationId String @map("reservation_id")
  addonId       String @map("addon_id")
  quantity      Int    @default(1)
  unitPrice     Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice    Decimal @map("total_price") @db.Decimal(10, 2)
  
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  addon       Addon       @relation(fields: [addonId], references: [id])
  
  @@map("reservation_addons")
}

// ============================================
// PAYMENTS & INVOICES
// ============================================

model Payment {
  id              String        @id @default(cuid())
  reservationId   String        @map("reservation_id")
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(PENDING)
  method          PaymentMethod @default(RAZORPAY)
  
  // Gateway details
  gatewayOrderId  String?       @map("gateway_order_id")
  gatewayPaymentId String?      @map("gateway_payment_id")
  gatewaySignature String?      @map("gateway_signature")
  gatewayResponse  String?      @map("gateway_response") @db.Text
  
  // Refund
  refundAmount    Decimal?      @map("refund_amount") @db.Decimal(12, 2)
  refundId        String?       @map("refund_id")
  refundedAt      DateTime?     @map("refunded_at")
  refundReason    String?       @map("refund_reason")
  
  notes           String?
  
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  
  reservation Reservation @relation(fields: [reservationId], references: [id])
  
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@map("payments")
}

model Invoice {
  id            String   @id @default(cuid())
  reservationId String   @map("reservation_id")
  invoiceNumber String   @unique @map("invoice_number")
  
  // Amounts
  subtotal      Decimal  @db.Decimal(12, 2)
  taxAmount     Decimal  @map("tax_amount") @db.Decimal(12, 2)
  discountAmount Decimal @map("discount_amount") @db.Decimal(12, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  
  // Tax details
  cgstRate      Decimal? @map("cgst_rate") @db.Decimal(5, 2)
  cgstAmount    Decimal? @map("cgst_amount") @db.Decimal(12, 2)
  sgstRate      Decimal? @map("sgst_rate") @db.Decimal(5, 2)
  sgstAmount    Decimal? @map("sgst_amount") @db.Decimal(12, 2)
  igstRate      Decimal? @map("igst_rate") @db.Decimal(5, 2)
  igstAmount    Decimal? @map("igst_amount") @db.Decimal(12, 2)
  
  pdfUrl        String?  @map("pdf_url")
  
  createdAt     DateTime @default(now()) @map("created_at")
  
  reservation Reservation @relation(fields: [reservationId], references: [id])
  
  @@map("invoices")
}

// ============================================
// COUPONS & OFFERS
// ============================================

model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  discountType    DiscountType @map("discount_type")
  discountValue   Decimal      @map("discount_value") @db.Decimal(10, 2)
  minBookingAmount Decimal?    @map("min_booking_amount") @db.Decimal(10, 2)
  maxDiscount     Decimal?     @map("max_discount") @db.Decimal(10, 2)
  startDate       DateTime     @map("start_date") @db.Date
  expiryDate      DateTime     @map("expiry_date") @db.Date
  usageLimit      Int?         @map("usage_limit")
  perUserLimit    Int          @default(1) @map("per_user_limit")
  usedCount       Int          @default(0) @map("used_count")
  isActive        Boolean      @default(true) @map("is_active")
  description     String?
  
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  
  roomTypes       CouponRoomType[]
  reservations    Reservation[]
  usage           CouponUsage[]
  
  @@map("coupons")
}

model CouponRoomType {
  id         String @id @default(cuid())
  couponId   String @map("coupon_id")
  roomTypeId String @map("room_type_id")
  
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  
  @@unique([couponId, roomTypeId])
  @@map("coupon_room_types")
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String   @map("coupon_id")
  userId    String   @map("user_id")
  usedAt    DateTime @default(now()) @map("used_at")
  
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  
  @@map("coupon_usage")
}

model Offer {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  image         String?
  description   String?  @db.Text
  shortDescription String? @map("short_description")
  discountType  DiscountType @map("discount_type")
  discountValue Decimal  @map("discount_value") @db.Decimal(10, 2)
  validFrom     DateTime @map("valid_from") @db.Date
  validTo       DateTime @map("valid_to") @db.Date
  bookingFrom   DateTime? @map("booking_from") @db.Date
  bookingTo     DateTime? @map("booking_to") @db.Date
  terms         String?  @db.Text
  promoCode     String?  @map("promo_code")
  minNights     Int?     @map("min_nights")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  roomTypes     OfferRoomType[]
  
  @@map("offers")
}

model OfferRoomType {
  id         String @id @default(cuid())
  offerId    String @map("offer_id")
  roomTypeId String @map("room_type_id")
  
  offer    Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  
  @@unique([offerId, roomTypeId])
  @@map("offer_room_types")
}

// ============================================
// HOUSEKEEPING & MAINTENANCE
// ============================================

model HousekeepingTask {
  id           String             @id @default(cuid())
  roomId       String             @map("room_id")
  status       HousekeepingStatus @default(DIRTY)
  assignedToId String?            @map("assigned_to_id")
  notes        String?
  startedAt    DateTime?          @map("started_at")
  completedAt  DateTime?          @map("completed_at")
  
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  
  room       Room @relation(fields: [roomId], references: [id])
  assignedTo User? @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  @@map("housekeeping_tasks")
}

model MaintenanceTicket {
  id           String              @id @default(cuid())
  roomId       String              @map("room_id")
  issue        String
  description  String?             @db.Text
  priority     MaintenancePriority @default(MEDIUM)
  status       MaintenanceStatus   @default(OPEN)
  reportedById String              @map("reported_by_id")
  assignedToId String?             @map("assigned_to_id")
  resolvedAt   DateTime?           @map("resolved_at")
  
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  
  room       Room @relation(fields: [roomId], references: [id])
  reportedBy User @relation("ReportedBy", fields: [reportedById], references: [id])
  assignedTo User? @relation("AssignedToMaintenance", fields: [assignedToId], references: [id])
  
  @@map("maintenance_tickets")
}

// ============================================
// HOTEL SETTINGS & CMS
// ============================================

model HotelSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
  type  String @default("text") // text, number, boolean, json, image, color
  group String @default("general") // general, contact, social, booking, tax, appearance
  label String?
  
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("hotel_settings")
}

model WebsiteSection {
  id      String  @id @default(cuid())
  section String  @unique // hero, about, facilities, dining, policies, etc.
  title   String?
  subtitle String?
  content String? @db.Text
  image   String?
  isActive Boolean @default(true) @map("is_active")
  metadata String? @db.Text // JSON for additional structured data
  
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("website_sections")
}

model Facility {
  id       String  @id @default(cuid())
  name     String
  icon     String?
  description String?
  image    String?
  isActive Boolean @default(true) @map("is_active")
  sortOrder Int    @default(0) @map("sort_order")
  
  @@map("facilities")
}

model GalleryImage {
  id       String  @id @default(cuid())
  url      String
  alt      String?
  category String  @default("hotel") // rooms, hotel, restaurant, pool, events, facilities
  sortOrder Int    @default(0) @map("sort_order")
  isFeatured Boolean @default(false) @map("is_featured")
  
  createdAt DateTime @default(now()) @map("created_at")
  
  @@map("gallery_images")
}

model NearbyAttraction {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  image       String?
  distance    String?
  travelTime  String? @map("travel_time")
  mapLink     String? @map("map_link")
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")
  
  @@map("nearby_attractions")
}

model Testimonial {
  id        String  @id @default(cuid())
  guestName String  @map("guest_name")
  rating    Int     @default(5)
  review    String  @db.Text
  stayDate  String? @map("stay_date")
  roomType  String? @map("room_type")
  isApproved Boolean @default(false) @map("is_approved")
  isFeatured Boolean @default(false) @map("is_featured")
  avatar    String?
  
  createdAt DateTime @default(now()) @map("created_at")
  
  @@map("testimonials")
}

// ============================================
// TAXES
// ============================================

model TaxConfig {
  id        String  @id @default(cuid())
  name      String
  rate      Decimal @db.Decimal(5, 2)
  type      String  @default("percentage") // percentage, fixed
  isActive  Boolean @default(true) @map("is_active")
  
  // GST slab config: applies when room rate falls within range
  minAmount Decimal? @map("min_amount") @db.Decimal(10, 2)
  maxAmount Decimal? @map("max_amount") @db.Decimal(10, 2)
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("tax_configs")
}

// ============================================
// CONTACT & NOTIFICATIONS
// ============================================

model ContactMessage {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  subject String
  message String  @db.Text
  isRead  Boolean @default(false) @map("is_read")
  
  createdAt DateTime @default(now()) @map("created_at")
  
  @@map("contact_messages")
}

model Notification {
  id      String  @id @default(cuid())
  userId  String? @map("user_id")
  title   String
  message String
  type    String  @default("info") // info, success, warning, error
  link    String?
  isRead  Boolean @default(false) @map("is_read")
  
  createdAt DateTime @default(now()) @map("created_at")
  
  user User? @relation(fields: [userId], references: [id])
  
  @@index([userId, isRead])
  @@map("notifications")
}

model EmailLog {
  id        String  @id @default(cuid())
  to        String
  subject   String
  template  String
  status    String  @default("sent") // sent, failed, bounced
  error     String?
  
  createdAt DateTime @default(now()) @map("created_at")
  
  @@map("email_logs")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id           String  @id @default(cuid())
  userId       String? @map("user_id")
  action       String
  entity       String
  entityId     String? @map("entity_id")
  previousValue String? @map("previous_value") @db.Text
  newValue     String? @map("new_value") @db.Text
  ipAddress    String? @map("ip_address")
  
  createdAt    DateTime @default(now()) @map("created_at")
  
  user User? @relation(fields: [userId], references: [id])
  
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
